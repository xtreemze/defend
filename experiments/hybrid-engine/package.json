{
  "name": "@defend/hybrid-engine-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ./rust --profile hybrid-wasm --target web --out-dir ../pkg --out-name defend_hybrid_runtime",
    "dev": "pnpm wasm && vite",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check ."
  },
  "dependencies": {
    "@babylonjs/accessibility": "9.23.0",
    "@babylonjs/core": "9.23.0",
    "@babylonjs/havok": "1.3.14",
    "@dimforge/rapier3d": "0.20.0"
  },
  "devDependencies": {
    "@babylonjs/inspector": "9.23.0",
    "@biomejs/biome": "2.5.11",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
