{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@defend/ui": [
        "../ui/src/index.ts"
      ],
      "@defend/ui/*": [
        "../ui/src/*"
      ],
      "@defend/*": [
        "../../src/js/*"
      ]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    ".storybook/**/*.ts",
    "src/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
